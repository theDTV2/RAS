@page
@model control.Pages.Account.LoginModel

@using control.Helper;
@using control.Generator;
@using control.Models;
@using control.Manager;

@{

	var lang = AccountHelper.GetUserLanguage(HttpContext);

	var ACCOUNT_LOGIN_TITLE = LanguageManager.GetLocalizedString("ACCOUNT_LOGIN_TITLE", lang);
	var ACCOUNT_LOGIN_MAIL_LABEL = LanguageManager.GetLocalizedStringWithParameter("ACCOUNT_LOGIN_MAIL_LABEL", GeneralSettingsManager.GetEmailSuffix(), lang);
	var ACCOUNT_LOGIN_BUTTON = LanguageManager.GetLocalizedString("ACCOUNT_LOGIN_BUTTON", lang);
	var ACCOUNT_LOGIN_INFO = LanguageManager.GetLocalizedString("ACCOUNT_LOGIN_INFO", lang);

	ViewData["Title"] = ACCOUNT_LOGIN_TITLE;


}

<div class="container-fluid">
	<div class="row">
		<div class="col-md-6">
			<form method="post">
				<div class="form-group">
					<label asp-for="UserEmail" class="control-label">@ACCOUNT_LOGIN_MAIL_LABEL</label>
					<input asp-for="UserEmail" class="form-control">
					<span asp-validation-for="UserEmail" class="text-danger"></span>

				</div>

				<div class="form-group">
					<input type="submit" value=@ACCOUNT_LOGIN_BUTTON class="btn btn-primary" />
				</div>


			</form>
		</div>

		<div class="col-md-6">
			<p>
				@ACCOUNT_LOGIN_INFO
			</p>
			<p>This application is currently undergoing active development and may undergo frequent changes and updates. If you encounter any issues or have suggestions for improvement, please don't hesitate to reach out to us at <b>lupak(at)htw-berlin.de</b>.</p>

		</div>
	</div>



</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
