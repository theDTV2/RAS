@page
@model control.Pages.Account.RegistrationModel

@using control.Helper;
@using control.Generator;
@using control.Models;
@using control.Manager;

@{

	var lang = AccountHelper.GetUserLanguage(HttpContext);
	var ACCOUNT_REGISTER_TITLE = LanguageManager.GetLocalizedString("ACCOUNT_REGISTER_TITLE", lang);
	var ACCOUNT_REGISTER_USER_FIRSTNAME = LanguageManager.GetLocalizedString("ACCOUNT_REGISTER_USER_FIRSTNAME", lang);
	var ACCOUNT_REGISTER_USER_LASTNAME = LanguageManager.GetLocalizedString("ACCOUNT_REGISTER_USER_LASTNAME", lang);
	var ACCOUNT_REGISTER_USER_CONFIRM = LanguageManager.GetLocalizedString("ACCOUNT_REGISTER_USER_CONFIRM", lang);
	var ACCOUNT_REGISTER_USER_BUTTON = LanguageManager.GetLocalizedString("ACCOUNT_REGISTER_USER_BUTTON", lang);
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
	<title>ACCOUNT_REGISTER_TITLE</title>
</head>
<body>

	<h4>ACCOUNT_REGISTER_TITLE</h4>
<hr />



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

	<form method="post">
		<div class="form-group">

			<label asp-for="firstName" class="control-label">@ACCOUNT_REGISTER_USER_FIRSTNAME</label>
			<input asp-for="firstName" class="form-control">
			<span asp-validation-for="firstName" class="text-danger"></span>

			<label asp-for="lastName" class="control-label">@ACCOUNT_REGISTER_USER_LASTNAME</label>
			<input asp-for="lastName" class="form-control">
			<span asp-validation-for="lastName" class="text-danger"></span>

			<label asp-for="AreYouSure" class="control-label">@ACCOUNT_REGISTER_USER_CONFIRM</label>
			<input asp-for="AreYouSure" class="form-check-inline">
			<span asp-validation-for="AreYouSure" class="checkbox"></span>

		</div>

		<div class="form-group">
			<input type="submit" value="@ACCOUNT_REGISTER_USER_BUTTON" class="btn btn-primary" />
		</div>

	</form>
</body>
</html>
