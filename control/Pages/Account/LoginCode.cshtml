@page
@model control.Pages.Account.LoginCodeModel

@{
    ViewData["Title"] = "LoginCode";
}

<h1>Login</h1>

<h4>User</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div class="form-group">
                <label class="control-label">Code für @ViewData["email"]:</label>
                <input asp-for="LoginCode" class="form-control">
                <span asp-validation-for="LoginCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Login" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
