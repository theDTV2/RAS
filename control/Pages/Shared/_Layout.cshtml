@using control.Helper;
@using control.Generator;
@using control.Models;
@using control.Manager;

@{
    //TODO: Add Localization
    string _userName = "Not logged In";
    EAccessLevel _userLevel = EAccessLevel.kNone;

    string _homeLink = "/Index";
    bool _loggedIn = AccountHelper.GetLoggedIn(Context);
    if (_loggedIn)
    {
        _userName = AccountHelper.GetUserName(Context);
        _userLevel = AccountHelper.GetEAccessLevel(Context);

        //TODO: Add Account expire date information, remove not accessible pages from layout

        _homeLink = "/Account/Dashboard";
    }
    var lang = AccountHelper.GetUserLanguage(Context);

    var LAYOUT_HOME = LanguageManager.GetLocalizedString("LAYOUT_HOME", lang);
    var LAYOUT_MANAGEMENT_DOOR = LanguageManager.GetLocalizedString("LAYOUT_MANAGEMENT_DOOR", lang);
    var LAYOUT_MANAGEMENT_DOOR_REGISTER = LanguageManager.GetLocalizedString("LAYOUT_MANAGEMENT_DOOR_REGISTER", lang);
    var LAYOUT_MANAGEMENT_DOOR_LIST = LanguageManager.GetLocalizedString("LAYOUT_MANAGEMENT_DOOR_LIST", lang);
    var LAYOUT_MANAGEMENT_USER = LanguageManager.GetLocalizedString("LAYOUT_MANAGEMENT_USER", lang);
    var LAYOUT_MANAGEMENT_USER_LIST = LanguageManager.GetLocalizedString("LAYOUT_MANAGEMENT_USER_LIST", lang);
    var LAYOUT_STATS = LanguageManager.GetLocalizedString("LAYOUT_STATS", lang);
    var LAYOUT_STATS_LIVE = LanguageManager.GetLocalizedString("LAYOUT_STATS_LIVE", lang);
    var LAYOUT_STATS_OVERTIME = LanguageManager.GetLocalizedString("LAYOUT_STATS_OVERTIME", lang);
    var LAYOUT_MANAGEMENT_SETTINGS = LanguageManager.GetLocalizedString("LAYOUT_MANAGEMENT_SETTINGS", lang);
    var LAYOUT_MANAGEMENT_SETTINGS_GENERAL = LanguageManager.GetLocalizedString("LAYOUT_MANAGEMENT_SETTINGS_GENERAL", lang);
    var LAYOUT_MANAGEMENT_SETTINGS_MAIL = LanguageManager.GetLocalizedString("LAYOUT_MANAGEMENT_SETTINGS_MAIL", lang);
    var LAYOUT_ACCOUNT_LOGIN = LanguageManager.GetLocalizedString("LAYOUT_ACCOUNT_LOGIN", lang);
    var LAYOUT_ACCOUNT_LOGOUT = LanguageManager.GetLocalizedString("LAYOUT_ACCOUNT_LOGOUT", lang);

    var _user_level_raw = @AccountHelper.GetAccessLevelAsString(Context);
    var LAYOUT_USER_LEVEL = LanguageManager.GetLocalizedString(_user_level_raw, lang);


}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Door Access System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap-select/css/bootstrap-select.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/control.styles.css" asp-append-version="true" />

</head>
<body>
    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="@_homeLink">Room Access System</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav flex-grow-1 ms-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="@_homeLink">@LAYOUT_HOME</a>
                        </li>
                        @if (_userLevel >= EAccessLevel.kAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @LAYOUT_MANAGEMENT_DOOR
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" asp-page="/Managment/Door/Register">@LAYOUT_MANAGEMENT_DOOR_REGISTER</a></li>
                                    <li><a class="dropdown-item" asp-page="/Managment/Door/List">@LAYOUT_MANAGEMENT_DOOR_LIST</a></li>
                                </ul>
                            </li>
                        }
                        @if (_userLevel >= EAccessLevel.kModerator)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @LAYOUT_MANAGEMENT_USER
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" asp-page="/Managment/User/List">@LAYOUT_MANAGEMENT_USER_LIST</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @LAYOUT_STATS
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item disabled" asp-page="" disabled="">@LAYOUT_STATS_LIVE</a></li>
                                    <li><a class="dropdown-item disabled" asp-page="" disabled="">@LAYOUT_STATS_OVERTIME</a></li>
                                </ul>
                            </li>
                        }


                        @if (_userLevel >= EAccessLevel.kSuperAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @LAYOUT_MANAGEMENT_SETTINGS
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" asp-page="/Managment/Settings/General">@LAYOUT_MANAGEMENT_SETTINGS_GENERAL</a></li>
                                    <li><a class="dropdown-item" asp-page="/Managment/Settings/Mail">@LAYOUT_MANAGEMENT_SETTINGS_MAIL</a></li>

                                </ul>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav me-auto">
                        @if (_loggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link disabled text-dark" asp-area="" asp-page="">@AccountHelper.GetUserName(Context) <br /> @LAYOUT_USER_LEVEL </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Account/Logout">@LAYOUT_ACCOUNT_LOGOUT</a>
                            </li>
                        }
                        @if (!_loggedIn)
                        {

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Account/Login">@LAYOUT_ACCOUNT_LOGIN</a>
                            </li>
                        }

                    </ul>


                </div>
            </div>
        </nav>

    </header>


    <div>@Html.Raw(@AlertGenerator.GetAlertsFromSession(Context))</div>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="border-top footer text-muted">
        <div class="container text-center">
            <div class="row">
                <div class="col-md-4">&copy; 2023 - RAS - <a asp-area="" asp-page="/Privacy">Privacy</a></div>
                <div class="col-md-4 ms-auto"><partial name="_LanguageSelectorPartial" /></div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>



    <script src="~/lib/bootstrap-select/js/bootstrap-select.min.js"></script>


    <script src="~/js/site.js" asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)


    <script>
        //TODO: Improve / Move this
        window.setTimeout(function () {
            $(".alert").fadeTo(500, 0).slideUp(500, function () {
                $(this).remove();
            });
        }, 4000);

    </script>
</body>
</html>