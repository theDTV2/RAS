@page "{DoorIdentifier}"
@model control.Pages.Managment.Door.ManageModel


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Manage</title>
</head>
<body>
    <h4>Manage Door</h4>
    <hr />
    <form method="post">
        <div class="container">
            <div class="row">
                <div class="col-sm">
                    Moderatoren hinzufügen/entfernen

                    <div class="form-group">
                        <label class="form-label" asp-for="DoorDisplayName"> </label>
                        <select class="selectpicker" asp-for="DoorAdminToGiveAccessTo" data-live-search="true" asp-items="(MultiSelectList)@ViewData["SelectBox"]!"></select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="DoorEntryMode"> </label>
                        <select class="selectpicker" asp-for="DoorEntryMode" asp-items="@Html.GetEnumSelectList(typeof(control.Models.EDoorEntryMode))" class="form-control"></select>
                    </div>
                    <br />

                </div>
                <div class="col-sm">
                    <a>Door ID: @Model.DoorID</a>

                    <div class="form-group">
                        <label class="form-label" asp-for="DoorDisplayName"> </label>
                        <input class="form-control" asp-for="DoorDisplayName">
                    </div>

                </div>
                <div class="col-sm">
                    TODO - PLACEHOLDER - TODO <br />
                    Hier kommt ein Log hin
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-4 text-center">
                    <div class="form-group">
                        <input type="submit" value="Update" class="btn btn-primary" />
                    </div>
                </div>
            </div>
            <div>
                <a class="btn btn-secondary" asp-page="List">Back</a>
            </div>
        </div>
    </form>

</body>
</html>
