@page
@model control.Pages.Account.PrivacyModel

@using control.Helper;
@using control.Generator;
@using control.Models;
@using control.Manager;

@{

    var lang = AccountHelper.GetUserLanguage(HttpContext);
    var ACCOUNT_PRIVACY_TITLE = LanguageManager.GetLocalizedString("ACCOUNT_PRIVACY_TITLE", lang);
    var ACCOUNT_PRIVACY_EULA = LanguageManager.GetLocalizedString("ACCOUNT_PRIVACY_EULA", lang);
    var ACCOUNT_PRIVACY_INFO = LanguageManager.GetLocalizedString("ACCOUNT_PRIVACY_INFO", lang);
    var ACCOUNT_PRIVACY_CHECKBOX_LABEL = LanguageManager.GetLocalizedString("ACCOUNT_PRIVACY_CHECKBOX_LABEL", lang);
    var ACCOUNT_PRIVACY_BUTTON_LABEL = LanguageManager.GetLocalizedString("ACCOUNT_PRIVACY_BUTTON_LABEL", lang);

}


<div class="jumbotron">
    <h1 class="display-4">@ACCOUNT_PRIVACY_INFO</h1>
    <hr class="my-4">
    <p>
       @Html.Raw(@ACCOUNT_PRIVACY_EULA)
    </p>

    <div class="row">
        <div class="col-md-4">
            <form method="post">
                <div class="form-group">
                    <label asp-for="AcceptEula" class="control-label">@ACCOUNT_PRIVACY_CHECKBOX_LABEL</label>
                    <input asp-for="AcceptEula" class="form-check-inline">
                    <span asp-validation-for="AcceptEula" class="text-danger"></span>
                </div>
                <div class="form-group btn btn-primary btn-lg">
                    <input type="submit" value="@ACCOUNT_PRIVACY_BUTTON_LABEL" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>

</div>
    

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

