@page
@model control.Pages.Managment.Site.MailModel

@using control.Helper;
@using control.Generator;
@using control.Models;
@using control.Manager;

@{

    var lang = AccountHelper.GetUserLanguage(HttpContext);
    var MANAGMENT_SETTINGS_EMAIL_TITLE = LanguageManager.GetLocalizedString("MANAGMENT_SETTINGS_EMAIL_TITLE", lang);
    var MANAGMENT_SETTINGS_EMAIL_INFO = LanguageManager.GetLocalizedString("MANAGMENT_SETTINGS_EMAIL_INFO", lang);
    var MANAGMENT_SETTINGS_EMAIL_USERNAME = LanguageManager.GetLocalizedString("MANAGMENT_SETTINGS_EMAIL_USERNAME", lang);
    var MANAGMENT_SETTINGS_EMAIL_PASSWORD = LanguageManager.GetLocalizedString("MANAGMENT_SETTINGS_EMAIL_PASSWORD", lang);
    var MANAGMENT_SETTINGS_EMAIL_SMTP_ADDRESS = LanguageManager.GetLocalizedString("MANAGMENT_SETTINGS_EMAIL_SMTP_ADDRESS", lang);
    var MANAGMENT_SETTINGS_EMAIL_SMTP_PORT = LanguageManager.GetLocalizedString("MANAGMENT_SETTINGS_EMAIL_SMTP_PORT", lang);

    var MANAGMENT_SETTINGS_EMAIL_SUBMIT = LanguageManager.GetLocalizedString("MANAGMENT_SETTINGS_EMAIL_SUBMIT", lang);
    var MANAGMENT_SETTINGS_EMAIL_BACK = LanguageManager.GetLocalizedString("MANAGMENT_SETTINGS_EMAIL_BACK", lang);

}

<form method="post">
    <div class="container">
        <div class="row">
            <div class="col-sm">
                <h4>@MANAGMENT_SETTINGS_EMAIL_TITLE </h4>
                <br />
                <div class="form-group">
                    <label class="form-label" asp-for="UserName"> @MANAGMENT_SETTINGS_EMAIL_USERNAME</label>
                    <input class="form-control" asp-for="UserName">
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Password">@MANAGMENT_SETTINGS_EMAIL_PASSWORD </label>
                    <input type="password" class="form-control " asp-for="Password">
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="SMTPServer">@MANAGMENT_SETTINGS_EMAIL_SMTP_ADDRESS </label>
                    <input class="form-control" asp-for="SMTPServer">
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Port">@MANAGMENT_SETTINGS_EMAIL_SMTP_PORT </label>
                    <input class="form-control" asp-for="Port">
                </div>
            </div>
            <div class="col-sm">
            </div>
            <div class="col-sm">
                @MANAGMENT_SETTINGS_EMAIL_INFO <br />
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-4 text-center">
                <div class="form-group">
                    <input type="submit" value="@MANAGMENT_SETTINGS_EMAIL_SUBMIT" class="btn btn-primary" />
                </div>
            </div>
        </div>
        <div>
            <a class="btn btn-secondary" asp-page="List">@MANAGMENT_SETTINGS_EMAIL_BACK</a>
        </div>
    </div>
</form>
