@page
@model control.Pages.Management.Site.GeneralModel

@using control.Helper;
@using control.Generator;
@using control.Models;
@using control.Manager;

@{

    var lang = AccountHelper.GetUserLanguage(HttpContext);
    var MANAGEMENT_SETTINGS_GENERAL_TITLE = LanguageManager.GetLocalizedString("MANAGEMENT_SETTINGS_GENERAL_TITLE", lang);
    var MANAGEMENT_SETTINGS_GENERAL_INFO = LanguageManager.GetLocalizedString("MANAGEMENT_SETTINGS_GENERAL_INFO", lang);
    var MANAGEMENT_SETTINGS_GENERAL_TIMEOUT = LanguageManager.GetLocalizedString("MANAGEMENT_SETTINGS_GENERAL_TIMEOUT_LABEL", lang);
    var MANAGEMENT_SETTINGS_GENERAL_TIMEOUT_TOOLTIP = LanguageManager.GetLocalizedString("MANAGEMENT_SETTINGS_GENERAL_TIMEOUT_LABEL", lang);

    var MANAGEMENT_SETTINGS_GENERAL_UPDATE = LanguageManager.GetLocalizedString("MANAGEMENT_SETTINGS_GENERAL_UPDATE", lang);
    var MANAGEMENT_SETTINGS_GENERAL_BACK = LanguageManager.GetLocalizedString("MANAGEMENT_SETTINGS_GENERAL_BACK", lang);

    var MANAGEMENT_SETTINGS_GENERAL_EMAIL_SUFFIX_TOOLTIP = LanguageManager.GetLocalizedString("MANAGEMENT_SETTINGS_GENERAL_EMAIL_SUFFIX_TOOLTIP", lang);

    var MANAGEMENT_SETTINGS_GENERAL_EMAIL_SUFFIX = LanguageManager.GetLocalizedString("MANAGEMENT_SETTINGS_GENERAL_EMAIL_SUFFIX", lang);

    var MANAGEMENT_SETTINGS_GENERAL_EMAIL_SUFFIX = LanguageManager.GetLocalizedString("MANAGEMENT_SETTINGS_HOSTNAME", lang);
    var MANAGEMENT_SETTINGS_GENERAL_EMAIL_SUFFIX = LanguageManager.GetLocalizedString("MANAGEMENT_SETTINGS_HOSTNAME_TOOLTIP", lang);


}
<form method="post">
    <div class="container">
        <div class="row">
            <div class="col-sm">
                <h4>@MANAGEMENT_SETTINGS_GENERAL_TITLE </h4>
                <br />
                <div class="form-group">
                    <label class="form-label" asp-for="UserLoginTimeout" data-toggle="tooltip" data-placement="top" title="@MANAGEMENT_SETTINGS_GENERAL_TIMEOUT_TOOLTIP">@MANAGEMENT_SETTINGS_GENERAL_TIMEOUT </label>
                    <input class="form-control" asp-for="UserLoginTimeout" data-toggle="tooltip" data-placement="top" title="@MANAGEMENT_SETTINGS_GENERAL_TIMEOUT_TOOLTIP">
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="EMailSuffix" data-toggle="tooltip" data-placement="top" title="@MANAGEMENT_SETTINGS_GENERAL_EMAIL_SUFFIX_TOOLTIP">@MANAGEMENT_SETTINGS_GENERAL_EMAIL_SUFFIX</label>
                    <input class="form-control" asp-for="EMailSuffix" data-toggle="tooltip" data-placement="top" title="@MANAGEMENT_SETTINGS_GENERAL_EMAIL_SUFFIX_TOOLTIP">
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="SiteHostName" data-toggle="tooltip" data-placement="top" title="@MANAGEMENT_SETTINGS_GENERAL_EMAIL_SUFFIX_TOOLTIP">@MANAGEMENT_SETTINGS_GENERAL_EMAIL_SUFFIX</label>
                    <input class="form-control" asp-for="SiteHostName" data-toggle="tooltip" data-placement="top" title="@MANAGEMENT_SETTINGS_GENERAL_EMAIL_SUFFIX_TOOLTIP">
                </div>
            </div>

            <div class="col-sm">
            </div>
            <div class="col-sm">
                @MANAGEMENT_SETTINGS_GENERAL_INFO<br />
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-4 text-center">
                <div class="form-group">
                    <input type="submit" value="@MANAGEMENT_SETTINGS_GENERAL_UPDATE" class="btn btn-primary" />
                </div>
            </div>
        </div>
        <div>
            <a class="btn btn-secondary" asp-page="List">@MANAGEMENT_SETTINGS_GENERAL_BACK</a>
        </div>
    </div>
</form>