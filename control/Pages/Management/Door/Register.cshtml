@page
@model control.Pages.Management.Door.RegisterModel

@using control.Helper;
@using control.Generator;
@using control.Models;
@using control.Manager;

@{

    var lang = AccountHelper.GetUserLanguage(HttpContext);
    var MANAGEMENT_DOOR_DISPLAYTEXT = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_DISPLAYTEXT", lang);
    var MANAGEMENT_DOOR_ID = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_ID", lang);


    var MANAGEMENT_DOOR_REGISTER_TITLE = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_REGISTER_TITLE", lang);
    var MANAGEMENT_DOOR_REGISTER_CREATE = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_REGISTER_CREATE", lang);
    var MANAGEMENT_DOOR_REGISTER_BACK = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_REGISTER_BACK", lang);
    var MANAGEMENT_DOOR_MANAGE_BACK = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_MANAGE_BACK", lang);


}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@MANAGEMENT_DOOR_REGISTER_TITLE</title>
</head>
<body>

    <h4>@MANAGEMENT_DOOR_REGISTER_TITLE</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                    <label asp-for="Door.Id" class="control-label">@MANAGEMENT_DOOR_ID</label>
                <input asp-for="Door.Id" class="form-control" />
                <span asp-validation-for="Door.Id" class="text-danger"></span>
            </div>
                <div class="form-group">
                    <label asp-for="Door.DisplayText" class="control-label">@MANAGEMENT_DOOR_DISPLAYTEXT</label>
                    <input asp-for="Door.DisplayText" class="form-control" />
                    <span asp-validation-for="Door.DisplayText" class="text-danger"></span>
                </div>
            <div class="form-group">
                    <input type="submit" value="@MANAGEMENT_DOOR_REGISTER_CREATE" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
        <a class="btn btn-secondary" asp-page="List">@MANAGEMENT_DOOR_REGISTER_BACK</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
</body>
</html>
