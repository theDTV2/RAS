@page
@model control.Pages.Managment.User.EditModel


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit</title>
</head>
<body>

<h4>User</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="User.UserName" />
            <div class="form-group">
                <label asp-for="User.FirstName" class="control-label"></label>
                <input asp-for="User.FirstName" class="form-control" />
                <span asp-validation-for="User.FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="User.LastName" class="control-label"></label>
                <input asp-for="User.LastName" class="form-control" />
                <span asp-validation-for="User.LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="User.AccessLevel" class="control-label"></label>
                <select asp-for="User.AccessLevel" class="form-control"></select>
                <span asp-validation-for="User.AccessLevel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="User.ExpiryDate" class="control-label"></label>
                <input asp-for="User.ExpiryDate" class="form-control" />
                <span asp-validation-for="User.ExpiryDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="User.AccessCode" class="control-label"></label>
                <input asp-for="User.AccessCode" class="form-control" />
                <span asp-validation-for="User.AccessCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="User.AccessCodeGenerationTime" class="control-label"></label>
                <input asp-for="User.AccessCodeGenerationTime" class="form-control" />
                <span asp-validation-for="User.AccessCodeGenerationTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="User.LastLogin" class="control-label"></label>
                <input asp-for="User.LastLogin" class="form-control" />
                <span asp-validation-for="User.LastLogin" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="User.AcceptedEula" /> @Html.DisplayNameFor(model => model.User.AcceptedEula)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="User.SecretCode" class="control-label"></label>
                <input asp-for="User.SecretCode" class="form-control" />
                <span asp-validation-for="User.SecretCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
</body>
</html>
