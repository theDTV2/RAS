@page "{handler?}"
@model control.Pages.Managment.User.UnlockModel

@{
    bool _editUserElements = Model.FoundElement;

}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Unlock</title>
</head>
<body>

    <h4>User</h4>
    <hr />

    <div class="row">
        <div class="col-sm-6">
            1
            <div class="align-content-center">
                <form asp-page-handler="Search" method="get">
                    <div class="form-group">
                        <label class="control-label">Search:</label>
                        <input asp-for="UserIdentifier" class="form-control">
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Search" class="btn btn-primary" />
                    </div>
                </form>

            </div>

        </div>

        <div class="col-sm-4 offset-lg-1">

            <form asp-page-handler="edit" method="post">
                <a>Ausgewählter Nutzer: @Model.UserIdentifier</a>

                <div class="form-group">
                    <label asp-for="LastName" class="control-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <button class="btn btn-secondary">Update</button>
            </form>


            <div class="row">
  
                <div class="col-sm-4">
                    <form asp-page-handler="delete" method="post">
                        <button class="btn btn-secondary disabled">Delete</button>
                    </form>
                </div>
                <div class="col-sm-4">
                    <form asp-page-handler="view" method="post">
                        <button class="btn btn-secondary disabled">View</button>
                    </form>
                </div>
            </div>

        </div>
    </div>


    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>
