@page
@model control.Pages.Management.Door.ListModel

@using control.Helper;
@using control.Generator;
@using control.Models;
@using control.Manager;

@{

    var lang = AccountHelper.GetUserLanguage(HttpContext);
    var MANAGEMENT_DOOR_LIST_TITLE = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_LIST_TITLE", lang);
    var MANAGEMENT_DOOR_LIST_NEW_DOOR = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_LIST_NEW_DOOR", lang);
    var MANAGEMENT_DOOR_DISPLAYTEXT = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_DISPLAYTEXT", lang);
    var MANAGEMENT_DOOR_ID = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_ID", lang);
    var MANAGEMENT_DOOR_LAST_CHECKIN = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_LAST_CHECKIN", lang);
    var MANAGEMENT_DOOR_LIST_LOG = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_LIST_LOG", lang);
    var MANAGEMENT_DOOR_LIST_MANAGE = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_LIST_MANAGE", lang);
    var MANAGEMENT_DOOR_LIST_DELETE = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_LIST_DELETE", lang);

    var ACCOUNT_EXTEND_BUTTON = LanguageManager.GetLocalizedString("ACCOUNT_EXTEND_BUTTON", lang);
}



<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@MANAGEMENT_DOOR_LIST_TITLE</title>
</head>
<body>
    <p>
        <a class="btn btn-primary" asp-page="Register">@MANAGEMENT_DOOR_LIST_NEW_DOOR </a>
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>
                    @MANAGEMENT_DOOR_DISPLAYTEXT
                </th>
                <th>
                    @MANAGEMENT_DOOR_ID
                </th>
                <th>
                    @MANAGEMENT_DOOR_LAST_CHECKIN
                </th>
                <th>

                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Door)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.DisplayText)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Id)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LastCheckInTime)
                    </td>
                    <td>
                        <a class="btn btn-primary" asp-page="Manage" asp-route-DoorIdentifier="@item.Id">@MANAGEMENT_DOOR_LIST_MANAGE</a>
                        <a class="btn btn-secondary" asp-page="Log" asp-route-DoorIdentifier="@item.Id">@MANAGEMENT_DOOR_LIST_LOG</a>
                   
                    @if(AccountHelper.GetEAccessLevel(HttpContext) >= Models.EAccessLevel.kAdmin)
                    {
                            <a class="btn btn-danger" asp-page="Delete" asp-route-DoorIdentifier="@item.Id">@MANAGEMENT_DOOR_LIST_DELETE</a>
                    }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
