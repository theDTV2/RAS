@page "{UserIdentifier?}"
@model control.Pages.Managment.User.UnlockModel

@{
    bool _editUserElements = Model.FoundElement;

}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Unlock</title>
</head>
<body>

    <h4>User</h4>
    <hr />
    <form asp-page-handler="edit" method="post">
        <div class="row">
            <div class="col-sm-6">
                <a>Ausgewählter Nutzer: @Model.UserIdentifier</a>

                <div class="form-group">
                    <label asp-for="LastName" class="control-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FirstName" class="control-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>



                <br />
                <a class="btn btn-primary" asp-page="List">Back</a>
            </div>

            <div class="col-sm-4 offset-lg-1">

                
                <div class="form-group">
                    <label asp-for="Secret" class="control-label"></label>
                    <input asp-for="Secret" class="form-control" />
                    <span asp-validation-for="Secret" class="text-danger"></span>
                </div>

                
                    <label asp-for="DoorsToGiveAccessTo" class="control-label"></label>
                    <select class="selectpicker" asp-for="DoorsToGiveAccessTo" asp-items="(MultiSelectList)@ViewData["Test"]!"></select>

                
                <br /> <div class="form-group">
                    <input type="submit" value="Update" class="btn btn-primary" />
                </div>
               
   


            </div>
        </div>

    </form>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>
