@page "{DoorIdentifier}"
@model control.Pages.Managment.Door.ManageModel

@using control.Helper;
@using control.Generator;
@using control.Models;
@using control.Manager;

@{

    var lang = AccountHelper.GetUserLanguage(HttpContext);
    var MANAGEMENT_DOOR_DISPLAYTEXT = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_DISPLAYTEXT", lang);
    var MANAGEMENT_DOOR_ID = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_ID", lang);

    var MANAGEMENT_DOOR_MANAGE_TITLE = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_MANAGE_TITLE", lang);

    var MANAGEMENT_DOOR_MANAGE_MODERATOR = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_MANAGE_MODERATOR", lang);
    var MANAGEMENT_DOOR_MANAGE_ENTRYMODE = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_MANAGE_ENTRYMODE", lang);
    var MANAGEMENT_DOOR_MANAGE_UPDATE = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_MANAGE_UPDATE", lang);
    var MANAGEMENT_DOOR_MANAGE_BACK = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_MANAGE_BACK", lang);


}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@MANAGEMENT_DOOR_MANAGE_TITLE</title>
</head>
<body>
    <h4>@MANAGEMENT_DOOR_MANAGE_TITLE</h4>
    <hr />
    <form method="post">
        <div class="container">
            <div class="row">
                <div class="col-sm">
                    <div class="form-group">
                        <label class="form-label" asp-for="DoorAdminToGiveAccessTo"> @MANAGEMENT_DOOR_MANAGE_MODERATOR</label>
                        <select class="selectpicker" asp-for="DoorAdminToGiveAccessTo" data-live-search="true" asp-items="(MultiSelectList)@ViewData["SelectBox"]!"></select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="DoorEntryMode">@MANAGEMENT_DOOR_MANAGE_ENTRYMODE </label> <br />
                        <select class="selectpicker" asp-for="DoorEntryMode" asp-items="@Html.GetEnumSelectList(typeof(control.Models.EDoorEntryMode))" class="form-control"></select>
                    </div>
                    <br />

                </div>
                <div class="col-sm">
                    <p>@MANAGEMENT_DOOR_ID</a></p>
                    <a> @Model.DoorID</a>
                    <br />
                    <br />
                    <div class="form-group">
                        <label class="form-label" asp-for="DoorDisplayText"> @MANAGEMENT_DOOR_DISPLAYTEXT</label>
                        <input class="form-control" asp-for="DoorDisplayText">
                    </div>

                </div>
                <div class="col-sm">
                    TODO - PLACEHOLDER DOOR LOG - TODO <br />
                </div>
            </div>

            <div>
                <a class="btn btn-secondary" asp-page="List">@MANAGEMENT_DOOR_MANAGE_BACK</a>
                <input type="submit" value="@MANAGEMENT_DOOR_MANAGE_UPDATE" class="btn btn-primary" />
            </div>
        </div>
    </form>

</body>
</html>
