@page "{handler?}"
@model control.Pages.Managment.User.ListModel

@using control.Helper;
@using control.Generator;
@using control.Models;
@using control.Manager;
@using System.Reflection;
@using System.ComponentModel.DataAnnotations;

@{
    var lang = AccountHelper.GetUserLanguage(HttpContext);
    var MANAGMENT_USER_EMAIL = LanguageManager.GetLocalizedString("MANAGMENT_USER_EMAIL", lang);
    var MANAGMENT_USER_FIRSTNAME = LanguageManager.GetLocalizedString("MANAGMENT_USER_FIRSTNAME", lang);
    var MANAGMENT_USER_LASTNAME = LanguageManager.GetLocalizedString("MANAGMENT_USER_LASTNAME", lang);
    var MANAGMENT_USER_ACCESSLEVEL = LanguageManager.GetLocalizedString("MANAGMENT_USER_ACCESSLEVEL", lang);
    var MANAGMENT_USER_EXPIRYDATE = LanguageManager.GetLocalizedString("MANAGMENT_USER_EXPIRYDATE", lang);
    var MANAGMENT_USER_LASTLOGIN = LanguageManager.GetLocalizedString("MANAGMENT_USER_LASTLOGIN", lang);

    var MANAGMENT_USER_COMPLETEDREGISTRATION = LanguageManager.GetLocalizedString("MANAGMENT_USER_COMPLETEDREGISTRATION", lang);
    var MANAGMENT_USER_LIST_MANAGE = LanguageManager.GetLocalizedString("MANAGMENT_USER_LIST_MANAGE", lang);
    var MANAGMENT_USER_LIST_UNLOCK = LanguageManager.GetLocalizedString("MANAGMENT_USER_LIST_UNLOCK", lang);
    var MANAGMENT_USER_LIST_SEARCH = LanguageManager.GetLocalizedString("MANAGMENT_USER_LIST_UNLOCK", lang);
    var MANAGMENT_USER_LIST_SEARCH_BACK = LanguageManager.GetLocalizedString("MANAGMENT_USER_LIST_SEARCH_BACK", lang);
   
}


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>List</title>
</head>
<body>
    <form method="get" asp-page-handler="Search">
        <div class="row">
            <div class="d-flex flex-row-reverse">
                <div class="p-2">
                    <input type="submit" value="Search" class="btn btn-primary" />
                </div>
                <div class="p-2">
                    <input asp-for="SearchTerm" class="form-control" value="" />
                </div>
                @if (Model.SearchedSomething)
                {
                    <div class="p-2">
                        <a class="btn btn-secondary" asp-page="List">@MANAGMENT_USER_LIST_SEARCH_BACK</a>
                    </div>
                }
            </div>
        </div>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>
                    <a> @MANAGMENT_USER_EMAIL</a>
                </th>
                <th>
                    <a> @MANAGMENT_USER_FIRSTNAME</a>
                </th>
                <th>
                    <a> @MANAGMENT_USER_LASTNAME</a>
                </th>
                <th>
                    <a> @MANAGMENT_USER_ACCESSLEVEL</a>
                </th>
                <th>
                    <a> @MANAGMENT_USER_EXPIRYDATE</a>
                </th>
                <th>
                    <a> @MANAGMENT_USER_LASTLOGIN</a>
                </th>
                <th>
                    <a> @MANAGMENT_USER_COMPLETEDREGISTRATION</a>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.User)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.UserName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FirstName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LastName)
                    </td>
                    <td>
                        @{
                            //IMO this is a very ugly way of doing this
                            //TODO: Improve accessing the Display Name Property of the Enum
                            var memberInfo = item.AccessLevel.GetType().GetMember(item.AccessLevel.ToString()!)[0];
                            var val = memberInfo.GetCustomAttribute<DisplayAttribute>()!.Name;
                        }
                            @Html.Raw(LanguageManager.GetLocalizedString(val!, lang))
                        
                       
                        
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ExpiryDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LastLogin)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CompletedRegistration)
                    </td>
                    <td>
                        <a class="btn btn-primary" asp-page="./Unlock" asp-route-UserIdentifier="@item.UserName">@MANAGMENT_USER_LIST_UNLOCK</a>


                        @if (AccountHelper.GetEAccessLevel(HttpContext) > item.AccessLevel || AccountHelper.GetEAccessLevel(HttpContext) == EAccessLevel.kSuperAdmin)
                        {
                            @Html.Raw("|");
                            <a class="btn btn-primary" asp-page="./Manage" asp-route-id="@item.UserName">@MANAGMENT_USER_LIST_MANAGE</a>
                        }

                    </td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
