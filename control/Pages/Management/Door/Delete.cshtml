@page "{DoorIdentifier}"
@model control.Pages.Managment.Door.DeleteModel

@using control.Helper;
@using control.Generator;
@using control.Models;
@using control.Manager;

@{

    var lang = AccountHelper.GetUserLanguage(HttpContext);
    var MANAGEMENT_DOOR_DELETE_TITLE = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_LIST_TITLE", lang);
    var MANAGEMENT_DOOR_DELETE_AREYOUSURE = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_DELETE_AREYOUSURE", lang);

    var MANAGEMENT_DOOR_DISPLAYTEXT = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_DISPLAYTEXT", lang);
    var MANAGEMENT_DOOR_ID = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_ID", lang);

    var MANAGEMENT_DOOR_DELETE_BACK = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_DELETE_BACK", lang);
    var MANAGEMENT_DOOR_DELETE_CONFIRM = LanguageManager.GetLocalizedString("MANAGEMENT_DOOR_DELETE_CONFIRM", lang);


}


<h1>@MANAGEMENT_DOOR_DELETE_TITLE</h1>

<h3>@MANAGEMENT_DOOR_DELETE_AREYOUSURE</h3>
<div>
    <br />
    <hr />
    <dl class="row">
     
        <dt class="col-sm-2">
            @MANAGEMENT_DOOR_ID
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Door.Id)
        </dd>
        <dt class="col-sm-2">
            @MANAGEMENT_DOOR_DISPLAYTEXT
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Door.DisplayText)
        </dd>

    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Door.Id" />
        <input type="submit" value="@MANAGEMENT_DOOR_DELETE_CONFIRM" class="btn btn-danger" /> |
        <a asp-page="./List">@MANAGEMENT_DOOR_DELETE_BACK</a>
    </form>
</div>
