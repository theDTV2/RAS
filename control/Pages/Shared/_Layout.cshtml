@using control.Helper;
@using control.Generator;
@using control.Models;
@{
    //TODO: Add Localization
    string _userName = "Not logged In";
    EAccessLevel _userLevel = EAccessLevel.kNone;

    string _homeLink = "/Index";
    bool _loggedIn = AccountHelper.GetLoggedIn(Context);
    if (_loggedIn)
    {
        _userName = AccountHelper.GetUserName(Context);
        _userLevel = AccountHelper.GetEAccessLevel(Context);
        _homeLink = "/Account/Dashboard";
    }

}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Door Access System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap-select/css/bootstrap-select.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/control.styles.css" asp-append-version="true" />

</head>
<body>
    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="@_homeLink">Room Access System</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
               
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav flex-grow-1 ms-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="@_homeLink">Home</a>
                        </li>
                        @if (_userLevel >= EAccessLevel.kAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Door Managment
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" asp-page="/Managment/Door/Register">Register</a></li>
                                    <li><a class="dropdown-item" asp-page="/Managment/Door/List">List</a></li>
                                </ul>
                            </li>
                        }
                        @if (_userLevel >= EAccessLevel.kModerator)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    User Managment
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" asp-page="/Managment/User/List">List</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    (Disabled) Stats
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item disabled" asp-page="" disabled="">Live</a></li>
                                    <li><a class="dropdown-item disabled" asp-page="" disabled="">Over Time</a></li>
                                </ul>
                            </li>
                        }


                          @if (_userLevel >= EAccessLevel.kSuperAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    System Managment
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item disabled" asp-page="/Managment/Settings/General">General Settings</a></li>
                                    <li><a class="dropdown-item" asp-page="/Managment/Settings/Mail">Mail Settings</a></li>

                                </ul>
                            </li>
                        }

                    </ul>

                     <ul class="navbar-nav me-auto">
                        @if (_loggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link disabled text-dark" asp-area="" asp-page="">@AccountHelper.GetUserName(Context) <br />  @AccountHelper.GetAccessLevelAsString(Context)</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Account/Logout">Logout</a>
                            </li>
                        }
                        @if (!_loggedIn)
                        {
       
                            <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Account/Login">Login</a>
                            </li>
                        }

                    </ul>


                </div>
            </div>
        </nav>

    </header>


    <div>@Html.Raw(@AlertGenerator.GetAlertsFromSession(Context))</div>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2023 - control - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>



    <script src="~/lib/bootstrap-select/js/bootstrap-select.min.js"></script>
   

    <script src="~/js/site.js" asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)


    <script>
        //TODO: Improve / Move this
        window.setTimeout(function () {
            $(".alert").fadeTo(500, 0).slideUp(500, function () {
                $(this).remove();
            });
        }, 4000);

    </script>
</body>
</html>