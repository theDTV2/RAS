@page
@model control.Pages.Managment.Door.ListModel


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>List</title>
</head>
<body>
    <p>
        <a class="btn btn-primary" asp-page="Register">Register new </a>
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Door[0].DisplayName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Door[0].Id)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Door[0].LastCheckInTime)
                </th>
                <th>

                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Door)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.DisplayName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Id)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LastCheckInTime)
                    </td>
                    <td>
                        <a class="btn btn-primary" asp-page="Manage" asp-route-DoorIdentifier="@item.Id">Manage</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
